 complaint volume trend"}}}},"/admin/audit-logs":{"get":{"summary":"View system-wide audit trail (Admin only)","tags":["Admin"],"security":[{"bearerAuth":[]}],"parameters":[{"in":"query","name":"userId","schema":{"type":"string"}},{"in":"query","name":"entityType","schema":{"type":"string","enum":["COMPLAINT","USER","CATEGORY"]}},{"in":"query","name":"action","schema":{"type":"string"}},{"in":"query","name":"dateFrom","schema":{"type":"string","format":"date-time"}},{"in":"query","name":"dateTo","schema":{"type":"string","format":"date-time"}},{"in":"query","name":"page","schema":{"type":"integer","default":0}},{"in":"query","name":"limit","schema":{"type":"integer","default":20}}],"responses":{"200":{"description":"Paginated audit log"}}}},"/admin/organizations":{"get":{"summary":"List all organizations (Admin only)","tags":["Admin"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Organization list"}}},"post":{"summary":"Create an organization (Admin only)","tags":["Admin"],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name","type"],"properties":{"name":{"type":"string"},"type":{"type":"string","enum":["GOVERNMENT","NGO","COMMUNITY_GROUP"]},"locationId":{"type":"string","format":"uuid"}}}}}},"responses":{"201":{"description":"Organization created"}}}}},"tags":[{"name":"Users","description":"User profile management"},{"name":"Photos","description":"Media upload for complaints"},{"name":"Notifications","description":"In-app notification centre"},{"name":"Locations","description":"Reference data — locations"},{"name":"Complaints","description":"Complaint lifecycle management"},{"name":"Categories","description":"Complaint categories"},{"name":"Auth","description":"Authentication & token management"},{"name":"Analytics","description":"KPI and trend data (org-scoped)"},{"name":"Admin","description":"Admin-only operations"}]}
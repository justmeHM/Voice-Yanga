<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Live Vercel API Domain & Localhost/Local Network Subnets -->
        <domain includeSubdomains="true">voice-yanga-api.vercel.app</domain>
        <domain includeSubdomains="true">vercel.app</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.54.58.10</domain>
        <domain includeSubdomains="true">10.11.106.10</domain>
        <domain includeSubdomains="true">10.42.177.10</domain>
        <domain includeSubdomains="true">10.227.108.10</domain>
        <domain includeSubdomains="true">10.214.122.10</domain>
        <domain includeSubdomains="true">192.168.43.35</domain>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".feature.complaints.CreateComplaintActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back_small"
            app:title="@string/create_complaint_title"
            app:titleTextColor="?attr/colorOnSurface">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickExit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:text="Quick Exit"
                android:textColor="@color/primary_red"
                android:textStyle="bold"
                app:icon="@drawable/ic_close_white"
                app:iconTint="@color/primary_red" />
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Step 1: Category Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What is the problem about?"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:spanCount="3"
                tools:listitem="@layout/item_category" />

            <!-- Step 2: Details (Hidden until category selected) -->
            <LinearLayout
                android:id="@+id/llStepDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="24dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginBottom="24dp" />

                <!-- Title -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTitle"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/complaint_title_label">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Custom Category Input (Hidden by default) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomCategory"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/label_custom_category"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sensitive Sub-Category Input (Hidden by default) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSubCategory"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Select Specific Sensitive Issue"
                    android:visibility="gone">
                    <AutoCompleteTextView
                        android:id="@+id/actvSubCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confidentiality Reassurance Banner (Hidden by default) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConfidentialBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#1A00C853"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 Confidential &amp; Urgent Report"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="This report is strictly private, assigned CRITICAL priority, and will NEVER appear on the public feed."
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Anonymous Submission Switch -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAnonymous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:text="Submit Anonymously (Hide my identity)"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Media Section (Horizontal) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="ADD EVIDENCE"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddEvidence"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Add Evidence (Photos, Voice, Video)"
                    app:icon="@drawable/ic_photos"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Voice Recording UI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVoiceNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:id="@+id/llRecordControls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStop"
                                style="@style/Widget.Material3.Button.IconButton.Filled"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:icon="@drawable/ic_stop"
                                app:backgroundTint="@color/primary_red" />
                            <TextView
                                android:id="@+id/tvRecordingTimer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="00:00"
                                android:textStyle="bold" />
                            <com.voiceyanga.citizen.ui.views.VisualizerView
                                android:id="@+id/visualizer"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/llPlaybackControls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlay"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:icon="@drawable/ic_play" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPause"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:visibility="gone"
                                app:icon="@drawable/ic_pause" />
                            <TextView
                                android:id="@+id/tvVoiceDuration"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="00:00" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDeleteVoice"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_delete_recording"
                                android:textColor="@color/primary_red"
                                app:icon="@drawable/ic_delete" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Video Attachment UI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVideoNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp">
                        <ImageView
                            android:id="@+id/ivVideoThumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#40000000" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlayVideoPreview"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_centerInParent="true"
                            app:icon="@drawable/ic_play"
                            app:iconSize="28dp"
                            app:backgroundTint="#80000000"
                            app:iconTint="@color/white" />
                        <TextView
                            android:id="@+id/tvVideoDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentStart="true"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_status_chip"
                            android:backgroundTint="#CC000000"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Video • 1:30 max" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeleteVideo"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:layout_margin="8dp"
                            app:icon="@drawable/ic_delete"
                            app:backgroundTint="#CC000000"
                            app:iconTint="@color/white" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description (Hidden if voice note is present) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDescription"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/complaint_desc_label">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Photo List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_photo" />

                <!-- Zero-Click Location -->
                <LinearLayout
                    android:id="@+id/llLocationResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location_vector"
                        app:tint="@color/primary_green" />
                    <ProgressBar
                        android:id="@+id/pbLocationLoading"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/tvDetectedLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/status_searching_gps"
                        android:textColor="@color/primary_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManualLocation"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Final Review Summary -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReviewSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/neutral_50"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@color/primary_green_light">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_review_summary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:alpha="0.6" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="View Full"
                                android:textColor="@color/primary_green"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                        <TextView
                            android:id="@+id/tvSummaryTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            tools:text="Broken Water Pipe" />
                        <TextView
                            android:id="@+id/tvSummaryCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/primary_green"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            tools:text="Category: Water" />
                        <TextView
                            android:id="@+id/tvSummaryMedia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="13sp"
                            tools:text="Evidence: 2 Photos • Voice Note Included" />
                        <TextView
                            android:id="@+id/tvSummaryLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"
                            tools:text="Location: Matero, Ward 24" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="32dp"
                    android:text="@string/submit_complaint_button"
                    android:textSize="16sp"
                    app:backgroundTint="@color/primary_green"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Mandatory for functionality but hidden in UI logic -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLocation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
